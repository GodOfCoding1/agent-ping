# Copy to .env.local (mode 0600). Never commit real values.
# Docker Compose uses ignored .env.compose / .env.compose.db from infra/compose_env.py.

APP_ENV=development
AUTH_MODE=development
DEV_AUTH_TOKEN=
DEV_USER_EMAIL=owner@agentping.local

# Pooled runtime (DML) and direct migration (DDL) URLs. Remote hosts need TLS.
DATABASE_URL=
MIGRATION_DATABASE_URL=
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
# Pytest overrides (optional). Default is the local compose test-db on 127.0.0.1:55433.
AGENTPING_TEST_DATABASE_URL=
AGENTPING_TEST_MIGRATION_DATABASE_URL=

NEON_PROJECT_ID=empty-surf-03967309
NEON_BRANCH=
GOOGLE_CLOUD_PROJECT=personalvm-511016
FIREBASE_PROJECT_ID=personalvm-511016
CLOUDSDK_ACTIVE_CONFIG_NAME=agentping
GOOGLE_CLOUD_REGION=asia-southeast1
ANDROID_APPLICATION_ID=com.errorfactory.agentping
# Leave GOOGLE_APPLICATION_CREDENTIALS unset to use standard local ADC.
# If needed, set it to a private FILE PATH, never literal service-account JSON.

PUBLIC_BASE_URL=http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated. Empty MCP lists are derived from PUBLIC_BASE_URL.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS=

PUSH_PROVIDER=log
FCM_DRY_RUN=false
FCM_RESTRICTED_PACKAGE_NAME=

OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_ANDROID_CLIENT_ID=
OIDC_JWKS_URL=
OIDC_ALLOWED_SUBJECTS=
OIDC_SCOPE_CLAIM=scope

LOG_LEVEL=INFO
LOG_JSON=true
MAX_REQUEST_BYTES=65536
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
DEFAULT_TIMEZONE=UTC

EMBEDDED_WORKER=false
WORKER_BATCH_SIZE=20
WORKER_LEASE_SECONDS=60
WORKER_IDLE_MAX_SECONDS=300
WORKER_IDLE_MIN_SECONDS=0.5
WORKER_MAX_ATTEMPTS=8
WORKER_LISTEN=true
WORKER_LISTEN_DATABASE_URL=
WORKER_TRIGGER_TOKEN=
MAINTENANCE_INTERVAL_SECONDS=21600
OCCURRENCE_HORIZON_DAYS=14
OCCURRENCE_HORIZON_COUNT=50
SYNC_CHANGE_RETENTION_DAYS=30
PAIRING_CODE_TTL_SECONDS=600
DEVICE_TOKEN_TTL_DAYS=365
AGENT_MAX_ACTIVE_REMINDERS=200
AGENT_MAX_RINGING_REMINDERS=25
AGENT_MAX_SENDS_PER_HOUR=60
MIN_RECURRENCE_INTERVAL_SECONDS=300
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
