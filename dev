#!/bin/sh
# AgentPing developer entrypoint. Loads host tooling, then either a setup probe or
# an application command. Secrets come from ignored .env.local via uv, never shell eval.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -f "$HOME/.config/agentping/env.sh" ]; then
  . "$HOME/.config/agentping/env.sh"
fi
if [ "$#" -eq 0 ]; then set -- doctor; fi
CMD=$1
shift

run_uv() {
  if [ -f "$ROOT/.env.local" ]; then
    uv run --project "$ROOT/backend" --locked --env-file "$ROOT/.env.local" "$@"
  else
    uv run --project "$ROOT/backend" --locked "$@"
  fi
}

case "$CMD" in
  doctor|imports|db-check|firebase-check)
    run_uv python "$ROOT/infra/smoke.py" "$CMD"
    ;;
  inspector)
    exec npx --yes @modelcontextprotocol/inspector@2.12.0 "$@"
    ;;
  compose-env)
    exec python3 "$ROOT/infra/compose_env.py" "$@"
    ;;
  compose)
    exec docker compose -f "$ROOT/compose.yaml" "$@"
    ;;
  test-db)
    exec docker compose -f "$ROOT/compose.yaml" --profile test up -d test-db
    ;;
  test)
    run_uv pytest -c "$ROOT/backend/pyproject.toml" "$@"
    ;;
  lint)
    cd "$ROOT/backend"
    run_uv ruff check .
    run_uv ruff format --check .
    run_uv mypy src tests
    ;;
  migrate)
    cd "$ROOT/backend"
    run_uv alembic "$@"
    ;;
  api)
    run_uv agentping-api
    ;;
  worker)
    run_uv agentping-worker "$@"
    ;;
  admin)
    run_uv agentping-admin "$@"
    ;;
  fcm-check)
    run_uv agentping-admin fcm-check "$@"
    ;;
  android-mcp-check)
    run_uv python "$ROOT/infra/android_mcp_smoke.py" "$@"
    ;;
  stack-smoke)
    run_uv python "$ROOT/infra/stack_smoke.py"
    ;;
  mcp-stdio)
    run_uv agentping-mcp-stdio
    ;;
  android-setup)
    exec python3 "$ROOT/infra/android_env.py" "$@"
    ;;
  android-gradle)
    cd "$ROOT/android"
    exec ./gradlew "$@"
    ;;
  android-check)
    cd "$ROOT/android"
    exec ./gradlew :app:assembleDebug :app:testDebugUnitTest :app:lintDebug --console=plain "$@"
    ;;
  android-release)
    cd "$ROOT/android"
    exec ./gradlew :app:assembleRelease :app:testDebugUnitTest :app:lintRelease --console=plain "$@"
    ;;
  android-production-run)
    if [ "$#" -lt 1 ]; then
      echo "Usage: ./dev android-production-run <adb-serial> [Gradle arguments]" >&2
      exit 2
    fi
    SERIAL=$1
    shift
    if [ "$(adb -s "$SERIAL" get-state 2>/dev/null || true)" != device ]; then
      echo "Device is unavailable or unauthorized; check adb devices -l." >&2
      exit 1
    fi
    if [ ! -f "$ROOT/android/signing.properties" ]; then
      echo "Production install needs ignored android/signing.properties; see android/README.md." >&2
      exit 1
    fi
    cd "$ROOT/android"
    ./gradlew :app:assembleRelease --console=plain "$@"
    exec android run --device="$SERIAL" --apks="$ROOT/android/app/build/outputs/apk/release/app-release.apk"
    ;;
  android-emulator)
    exec android emulator start "${1:-AgentPing_API36}"
    ;;
  android-device|android-run|android-test)
    if [ "$#" -lt 1 ]; then
      echo "Usage: ./dev $CMD <adb-serial> [Gradle arguments]" >&2
      exit 2
    fi
    SERIAL=$1
    shift
    if [ "$(adb -s "$SERIAL" get-state 2>/dev/null || true)" != device ]; then
      echo "Device is unavailable or unauthorized; check adb devices -l and approve USB debugging." >&2
      exit 1
    fi
    # Development builds use the local backend; production installs above use HTTPS directly.
    adb -s "$SERIAL" reverse tcp:8000 tcp:8000
    case "$CMD" in
      android-device)
        echo "Device ready: $SERIAL; backend at http://127.0.0.1:8000/ through USB/emulator reverse"
        ;;
      android-run)
        cd "$ROOT/android"
        ./gradlew :app:assembleDebug --console=plain "$@"
        exec android run --device="$SERIAL" --apks="$ROOT/android/app/build/outputs/apk/debug/app-debug.apk"
        ;;
      android-test)
        cd "$ROOT/android"
        ANDROID_SERIAL="$SERIAL" ./gradlew :app:connectedDebugAndroidTest --console=plain "$@"
        ;;
    esac
    ;;
  *)
    cat <<EOF
Usage: ./dev <command> [args]

Setup probes:     doctor | imports | db-check | firebase-check | inspector
Local stack:      compose-env | compose [...] | test-db | stack-smoke
Application:      api | worker | migrate [...] | admin [...] | fcm-check | mcp-stdio
Quality:          test | lint
Android:          android-setup | android-check | android-release | android-gradle [...] | android-emulator [AVD]
Device (serial):  android-device | android-run | android-production-run | android-test
EOF
    exit 2
    ;;
esac
